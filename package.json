{
  "name": "opsara-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Opsara AI (formerly GuardRail): security gateway and agentic workspace for coding agents",
  "scripts": {
    "dev": "node server.mjs --dev -p 3000",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock:vllm": "node scripts/mock-vllm.mjs",
    "seed": "tsx scripts/seed.ts",
    "dev:next": "next dev -p 3000",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
